# Server-only. Used to bootstrap the first hashed admin password.
ADMIN_PASSKEY=change-me

# Server-only. HMAC secret for signed admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional. Persist content across serverless instances (Vercel Blob).
# BLOB_READ_WRITE_TOKEN=

# Optional. Contact inbox. Defaults to info@kmci.org
# CONTACT_TO_EMAIL=info@kmci.org

# Optional. If set, contact form sends via Resend. Otherwise FormSubmit is used.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=KMCI <onboarding@resend.dev>
